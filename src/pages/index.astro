---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ChatDemo from '../components/ChatDemo.astro';
import Features from '../components/Features.astro';
import Goals from '../components/Goals.astro';
import WhyTelegram from '../components/WhyTelegram.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Feedback from '../components/Feedback.astro';
import Footer from '../components/Footer.astro';
import copy from '../copy.json';
const m = copy.modal;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={copy.meta.description} />
    <meta name="theme-color" content="#FAFAF7" />

    <!-- Open Graph -->
    <meta property="og:title" content={copy.meta.ogTitle} />
    <meta property="og:description" content={copy.meta.ogDescription} />
    <meta property="og:type" content="website" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <title>{copy.meta.title}</title>
  </head>
  <body>
    <Navbar />
    <main>
      <Hero />
      <ChatDemo />
      <Features />
      <Goals />
      <WhyTelegram />
      <ComingSoon />
      <Feedback />
    </main>
    <Footer />

    <!-- Whitelist modal -->
    <div class="modal" id="whitelistModal" aria-hidden="true">
      <div class="modal-backdrop" data-close></div>
      <div class="modal-card" role="dialog" aria-labelledby="modalTitle">
        <button class="modal-close" type="button" data-close aria-label="Close">×</button>

        <div class="modal-eyebrow">
          <span class="live-dot"></span> {m.eyebrow}
        </div>
        <h3 class="modal-title" id="modalTitle">{m.headline}</h3>
        <p class="modal-sub">{m.sub}</p>

        <form class="modal-form" id="whitelistForm">
          <div class="field">
            <label for="handle">{m.handleLabel}</label>
            <div class="input-prefix">
              <span class="prefix-glyph">@</span>
              <input id="handle" type="text" placeholder={m.handlePlaceholder} required pattern="[A-Za-z0-9_]{3,32}" minlength="3" maxlength="32" autocomplete="off" />
            </div>
          </div>
          <div class="field">
            <label for="reason">{m.reasonLabel} <span class="opt">{m.reasonOptional}</span></label>
            <input id="reason" class="input" type="text" placeholder={m.reasonPlaceholder} maxlength="80" />
          </div>
          <button class="btn btn-primary modal-submit" type="submit">
            {m.submit}
            <span class="arrow">→</span>
          </button>
          <p class="modal-foot-text">
            {m.footerParts[0]}<span class="dot"></span>{m.footerParts[1]}<span class="dot"></span>{m.footerParts[2]}
          </p>
        </form>

        <div class="modal-success">
          <div class="modal-success-icon">✓</div>
          <h4>{m.successTitle}</h4>
          <p set:html={m.successBodyHtml}></p>
          <button class="btn btn-ghost" type="button" data-close>{m.successClose}</button>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // ── nav blur on scroll ──
        const nav = document.getElementById('nav');
        const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 12);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // ── reveal on intersect ──
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));

        // ── whitelist modal ──
        const modal = document.getElementById('whitelistModal');
        const modalCard = modal?.querySelector('.modal-card');
        const handleInput = document.getElementById('handle') as HTMLInputElement | null;

        const openModal = () => {
          modalCard?.classList.remove('success');
          (document.getElementById('whitelistForm') as HTMLFormElement)?.reset();
          const submitBtn = document.querySelector('.modal-submit') as HTMLButtonElement | null;
          if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = 'Add me to the list <span class="arrow">→</span>'; }
          modal?.classList.add('open');
          modal?.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          setTimeout(() => handleInput?.focus(), 80);
        };
        const closeModal = () => {
          modal?.classList.remove('open');
          modal?.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        };

        modal?.querySelectorAll('[data-close]').forEach(el =>
          el.addEventListener('click', closeModal)
        );
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
        });

        // intercept all Telegram CTA links
        document.querySelectorAll('a[data-whitelist]').forEach(a => {
          a.addEventListener('click', (e) => {
            e.preventDefault();
            openModal();
          });
        });

        // submit → API → success state
        document.getElementById('whitelistForm')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const handle = handleInput?.value.replace(/^@/, '').trim() || '';
          const reason = (document.getElementById('reason') as HTMLInputElement)?.value.trim();
          const submitBtn = document.querySelector('.modal-submit') as HTMLButtonElement | null;

          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

          try {
            await fetch('/api/waitlist', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ telegram: handle, reason }),
            });
          } catch { /* show success regardless — don't block UX on network errors */ }

          const echo = document.getElementById('handleEcho');
          if (echo) echo.textContent = handle || 'yourname';
          modalCard?.classList.add('success');
        });
      });
    </script>
  </body>
</html>
