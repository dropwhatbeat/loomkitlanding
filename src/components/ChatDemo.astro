---
import copy from '../copy.json';
const c = copy.chatDemo;
---
<section class="section" id="how">
  <div class="wrap">
    <div class="how-grid">
      <div class="how-copy reveal">
        <span class="eyebrow"><span class="bar"></span> {c.eyebrow}</span>
        <h2>{c.headlineLine1}<br/>{c.headlineLine2}</h2>
        <p>{c.body}</p>
        <div class="how-tagline">
          <span class="em">{c.tagline}</span>
        </div>
      </div>

      <div class="chat-stack reveal stagger">
        {c.messages.map(msg => (
          <div class="chat-row">
            <div class="stack-bubble me">{msg.user}</div>
            <div class="stack-bubble bot"><span class="check">✓</span>{msg.bot}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .how-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 920px) { .how-grid { grid-template-columns: 1fr; } }

  .how-copy .eyebrow { margin-bottom: 24px; }
  .how-copy h2 { margin-bottom: 22px; }
  .how-copy p { font-size: 18px; max-width: 460px; line-height: 1.5; }
  .how-tagline {
    margin-top: 36px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .how-tagline .em { color: var(--ink); font-weight: 500; }

  .chat-stack {
    background: var(--paper-2);
    border: 1px solid var(--hair);
    border-radius: var(--r-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .chat-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 0;
  }
  .chat-row + .chat-row { border-top: 1px solid var(--hair); }
  .chat-row:first-child { padding-top: 4px; }
  .chat-row:last-child { padding-bottom: 4px; }

  .stack-bubble {
    max-width: 82%;
    padding: 11px 16px;
    border-radius: 16px;
    font-size: 15px;
    line-height: 1.45;
  }
  .stack-bubble.me {
    align-self: flex-end;
    background: var(--ink);
    color: var(--paper);
    border-bottom-right-radius: 5px;
  }
  .stack-bubble.bot {
    align-self: flex-start;
    background: var(--paper-3);
    color: var(--ink);
    border-bottom-left-radius: 5px;
  }
  .stack-bubble .check {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--tick);
    color: white;
    font-size: 9px;
    font-weight: 800;
    margin-right: 6px;
    vertical-align: 1px;
  }
</style>
