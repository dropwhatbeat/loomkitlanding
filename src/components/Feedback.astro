---
import copy from '../copy.json';
const c = copy.feedback;
---
<section class="section alt" id="feedback">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow"><span class="num">06</span> <span class="bar"></span> {c.eyebrow}</span>
      </div>
      <div>
        <h2>{c.headline}</h2>
        <p class="lede">{c.lede}</p>
      </div>
    </div>

    <form class="feedback-card reveal" id="feedbackForm">
      <div class="field">
        <label for="msg">Your message</label>
        <textarea id="msg" name="message" class="textarea" placeholder={c.messagePlaceholder} required></textarea>
      </div>
      <div class="field">
        <label for="email">{c.emailLabel} <span class="opt">{c.emailOptional}</span></label>
        <input id="email" name="email" class="input" type="email" placeholder={c.emailPlaceholder} />
      </div>
      <div class="feedback-foot">
        <span class="hint">{c.hint}</span>
        <button class="btn btn-primary" type="submit" id="submit-btn">
          {c.submit}
          <span class="arrow">→</span>
        </button>
      </div>
      <div class="feedback-success" id="success">
        <span style="font-weight:700;">✓</span> {c.success}
      </div>
    </form>
  </div>
</section>

<style>
  .feedback-card {
    max-width: 640px;
    margin: 0 auto;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    border-radius: var(--r-xl);
    padding: 40px;
  }
  .feedback-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .feedback-foot .hint {
    font-size: 13px;
    color: var(--muted);
  }
  .feedback-success {
    display: none;
    background: var(--tick-soft);
    border: 1px solid rgba(22,163,74,0.25);
    color: #14803a;
    padding: 14px 18px;
    border-radius: 12px;
    font-size: 14px;
    margin-top: 16px;
    align-items: center;
    gap: 10px;
  }
  .feedback-success.show { display: flex; }
</style>

<script>
  const form = document.getElementById('feedbackForm') as HTMLFormElement | null;
  const successEl = document.getElementById('success');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }

    const formData = new FormData(form);

    try {
      const response = await fetch('/api/feedback', {
        method: 'POST',
        body: JSON.stringify({
          message: formData.get('message'),
          email: formData.get('email') || undefined,
        }),
        headers: { 'Content-Type': 'application/json' },
      });

      if (response.ok) {
        successEl?.classList.add('show');
        form.reset();
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = 'Send it <span class="arrow">→</span>'; }
      } else {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send it';
        }
        alert('Something went wrong. Please try again.');
      }
    } catch {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send it';
      }
      alert('Something went wrong. Please try again.');
    }
  });
</script>
