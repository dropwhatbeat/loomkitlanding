---
---
<section class="section alt" id="feedback">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow"><span class="num">06</span> <span class="bar"></span> Feedback</span>
      </div>
      <div>
        <h2>Got thoughts? We actually read these.</h2>
        <p class="lede">Bug, feature wish, half-baked idea, kind word — all welcome. We reply from a real keyboard.</p>
      </div>
    </div>

    <form class="feedback-card reveal" id="feedbackForm">
      <div class="field">
        <label for="msg">Your message</label>
        <textarea id="msg" name="message" class="textarea" placeholder="What's on your mind? Be as informal as you like — we are." required></textarea>
      </div>
      <div class="field">
        <label for="email">Email <span class="opt">(optional — only if you want a reply)</span></label>
        <input id="email" name="email" class="input" type="email" placeholder="you@somewhere.cool" />
      </div>
      <div class="feedback-foot">
        <span class="hint">We read every one. Promise.</span>
        <button class="btn btn-primary" type="submit" id="submit-btn">
          Send it
          <span class="arrow">→</span>
        </button>
      </div>
      <div class="feedback-success" id="success">
        <span style="font-weight:700;">✓</span> Got it. Thanks — we'll write back if you left an email.
      </div>
    </form>
  </div>
</section>

<style>
  .feedback-card {
    max-width: 640px;
    margin: 0 auto;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    border-radius: var(--r-xl);
    padding: 40px;
  }
  .feedback-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .feedback-foot .hint {
    font-size: 13px;
    color: var(--muted);
  }
  .feedback-success {
    display: none;
    background: var(--tick-soft);
    border: 1px solid rgba(22,163,74,0.25);
    color: #14803a;
    padding: 14px 18px;
    border-radius: 12px;
    font-size: 14px;
    margin-top: 16px;
    align-items: center;
    gap: 10px;
  }
  .feedback-success.show { display: flex; }
</style>

<script>
  const form = document.getElementById('feedbackForm') as HTMLFormElement | null;
  const successEl = document.getElementById('success');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }

    const formData = new FormData(form);

    try {
      const response = await fetch('https://formspree.io/f/xpwzgvkr', {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        successEl?.classList.add('show');
        form.reset();
      } else {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send it';
        }
        alert('Something went wrong. Please try again.');
      }
    } catch {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send it';
      }
      alert('Something went wrong. Please try again.');
    }
  });
</script>
