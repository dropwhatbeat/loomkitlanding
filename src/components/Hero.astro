---
---
<section class="min-h-screen flex items-center pt-20 pb-16 px-6">
  <div class="max-w-7xl mx-auto w-full">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-8">

      <!-- Left column -->
      <div class="flex-1 md:w-3/5 hero-text" style="animation: fadeInUp 0.8s ease forwards;">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-[#7C3AED]/10 border border-[#7C3AED]/30 text-[#7C3AED] text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse"></span>
          Now in Telegram
        </div>

        <!-- H1 -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-[#F9FAFB] leading-tight mb-6">
          Your brain's backup.<br />
          <span class="text-[#7C3AED]">Lives in Telegram.</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg text-[#6B7280] leading-relaxed mb-8 max-w-xl">
          Log expenses, calories, and reminders in plain English. No app. No friction. Just type.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="https://t.me/Loomkit_bot"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200 hover:scale-105 hover:shadow-lg hover:shadow-[#7C3AED]/25"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.17 13.585l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.978.974z"/>
            </svg>
            Open @Loomkit_bot
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center gap-2 border border-[#6B7280]/40 hover:border-[#7C3AED]/60 text-[#F9FAFB] font-semibold px-6 py-3 rounded-xl transition-all duration-200 hover:bg-[#7C3AED]/5"
          >
            See how it works
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right column: Phone mockup -->
      <div class="md:w-2/5 flex justify-center items-center">
        <div class="phone-float" style="animation: phoneBob 3s ease-in-out infinite;">
          <!-- Phone outer shell -->
          <div class="relative w-64 h-[480px] bg-[#1A1A1A] rounded-[3rem] border-4 border-[#2A2A2A] shadow-2xl overflow-hidden" style="box-shadow: 0 25px 60px rgba(124, 58, 237, 0.2), 0 0 0 1px rgba(124,58,237,0.1);">
            <!-- Notch -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-6 bg-[#1A1A1A] rounded-b-2xl z-10"></div>

            <!-- Screen -->
            <div class="absolute inset-1 bg-[#0D0D0D] rounded-[2.5rem] overflow-hidden flex flex-col">
              <!-- Telegram header -->
              <div class="bg-[#1A1A2E] px-4 pt-8 pb-3 flex items-center gap-3 border-b border-gray-800/50">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#7C3AED] to-[#10B981] flex items-center justify-center text-xs font-bold text-white">L</div>
                <div>
                  <p class="text-[#F9FAFB] text-xs font-semibold">LoomKit</p>
                  <p class="text-[#10B981] text-[10px]">bot</p>
                </div>
              </div>

              <!-- Chat bubbles -->
              <div class="flex-1 px-3 py-4 flex flex-col gap-3 overflow-hidden">
                <!-- User bubble -->
                <div class="flex justify-end">
                  <div class="bg-[#7C3AED] text-white text-xs px-3 py-2 rounded-2xl rounded-tr-sm max-w-[80%]">
                    Spent $18 on lunch
                  </div>
                </div>
                <!-- Bot bubble -->
                <div class="flex justify-start">
                  <div class="bg-[#1A1A2E] text-[#F9FAFB] text-xs px-3 py-2 rounded-2xl rounded-tl-sm max-w-[80%]">
                    ✅ $18 logged under Food
                  </div>
                </div>
                <!-- User bubble -->
                <div class="flex justify-end">
                  <div class="bg-[#7C3AED] text-white text-xs px-3 py-2 rounded-2xl rounded-tr-sm max-w-[80%]">
                    Remind me to call mum in 2 hrs
                  </div>
                </div>
                <!-- Bot bubble -->
                <div class="flex justify-start">
                  <div class="bg-[#1A1A2E] text-[#F9FAFB] text-xs px-3 py-2 rounded-2xl rounded-tl-sm max-w-[80%]">
                    ✅ Reminder set for 2:00 PM
                  </div>
                </div>
              </div>

              <!-- Input bar -->
              <div class="px-3 pb-4">
                <div class="bg-[#1A1A2E] rounded-full px-4 py-2 flex items-center gap-2">
                  <span class="text-[#6B7280] text-[10px] flex-1">Message...</span>
                  <div class="w-5 h-5 rounded-full bg-[#7C3AED] flex items-center justify-center">
                    <svg width="8" height="8" viewBox="0 0 24 24" fill="white">
                      <path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes phoneBob {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  .hero-text {
    opacity: 0;
  }
</style>
