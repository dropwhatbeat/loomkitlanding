---
---
<section class="hero" id="top">
  <div class="wrap">

    <div class="hero-header hero-copy">
      <span class="eyebrow"><span class="bar"></span> Live on Telegram · @Loomkit_bot</span>
      <h1>
        Your brain's backup<span class="em">.</span><br />
        Lives in&nbsp;Telegram.
      </h1>
      <p class="hero-sub">
        Tell LoomKit what you ate, what you spent, what you need to remember.
        One plain-English sentence — it parses everything in parallel, weighs it against your goals, and replies.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="https://t.me/Loomkit_bot" data-whitelist>
          Open @Loomkit_bot
          <span class="arrow">→</span>
        </a>
        <a class="btn btn-ghost" href="#how">See how it works</a>
      </div>
      <div class="hero-beta-hint">
        <span class="badge"><span class="dot"></span> Private beta</span>
        <span>We whitelist by hand — usually within 48h.</span>
      </div>
    </div>

    <!-- Extraction diagram -->
    <div class="extract reveal">
      <div class="extract-input">
        <span class="extract-step"><span class="num">1</span> You type</span>
        <div class="extract-bubble">
          <span>I ate chicken rice for dinner, $7</span>
          <span class="time">19:42</span>
        </div>
      </div>

      <div class="extract-fan">
        <svg viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
          <path d="M500,0 C500,40 125,40 125,80" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="3 4" />
          <path d="M500,0 C500,40 375,40 375,80" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="3 4" />
          <path d="M500,0 C500,40 625,40 625,80" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="3 4" />
          <path d="M500,0 C500,40 875,40 875,80" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="3 4" />
        </svg>
        <span class="extract-fan-label">
          <span class="num">2</span> LoomKit extracts &nbsp;·&nbsp; in parallel
        </span>
      </div>

      <div class="extract-grid stagger reveal">
        <!-- Expense card -->
        <div class="ex-card">
          <div class="ex-card-head">
            <span class="ex-label">Expense</span>
            <span class="ex-glyph">$</span>
          </div>
          <div class="ex-value">$7.00</div>
          <div class="ex-sub">→ Food · Dinner</div>
          <div class="ex-bar"><div class="ex-bar-fill" style="width: 42%"></div></div>
          <div class="ex-bar-label"><span>$335 / $800</span><span>May</span></div>
        </div>

        <!-- Calories card -->
        <div class="ex-card">
          <div class="ex-card-head">
            <span class="ex-label">Calories</span>
            <span class="ex-glyph">◐</span>
          </div>
          <div class="ex-value">~520<span class="ex-value-unit">kcal</span></div>
          <div class="ex-sub">→ Dinner · estimated</div>
          <div class="ex-bar"><div class="ex-bar-fill" style="width: 74%"></div></div>
          <div class="ex-bar-label"><span>1,340 / 1,800</span><span>today</span></div>
        </div>

        <!-- Macros card -->
        <div class="ex-card">
          <div class="ex-card-head">
            <span class="ex-label">Macros</span>
            <span class="ex-glyph">◔</span>
          </div>
          <div class="ex-macros">
            <div class="ex-macro-row">
              <span class="ex-macro-k">P</span>
              <div class="ex-macro-bar"><div class="ex-macro-fill" style="width: 32%"></div></div>
              <span class="ex-macro-v">28g</span>
            </div>
            <div class="ex-macro-row">
              <span class="ex-macro-k">C</span>
              <div class="ex-macro-bar"><div class="ex-macro-fill" style="width: 78%"></div></div>
              <span class="ex-macro-v">75g</span>
            </div>
            <div class="ex-macro-row">
              <span class="ex-macro-k">F</span>
              <div class="ex-macro-bar"><div class="ex-macro-fill" style="width: 22%"></div></div>
              <span class="ex-macro-v">12g</span>
            </div>
          </div>
          <div class="ex-bar-label" style="margin-top: 14px;"><span>per serving</span><span>est.</span></div>
        </div>

        <!-- Reply card -->
        <div class="ex-card ex-reply">
          <div class="ex-card-head">
            <span class="ex-label">Reply</span>
            <span class="ex-glyph">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>
            </span>
          </div>
          <div class="ex-reply-bubble">
            <span class="tick">✓</span>Logged. <strong>1,340/1,800 kcal</strong> today, <strong>$335/$800</strong> in May. On track — go easy on tomorrow's lunch.
          </div>
          <div class="ex-reply-tag">
            <span class="dot"></span>
            sent · 19:42
          </div>
        </div>
      </div>
    </div>

    <!-- Meta strip -->
    <div class="hero-meta">
      <div class="hero-meta-item">
        <span class="k">Status</span>
        <span class="v"><span class="live-dot"></span> Online</span>
      </div>
      <div class="hero-meta-item">
        <span class="k">Inputs per message</span>
        <span class="v">1</span>
      </div>
      <div class="hero-meta-item">
        <span class="k">Things tracked</span>
        <span class="v">3 + goals</span>
      </div>
      <div class="hero-meta-item">
        <span class="k">Time to log</span>
        <span class="v">&lt; 3 sec</span>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 80px 0 96px;
  }
  @media (max-width: 920px) { .hero { padding: 56px 0 72px; } }

  .hero-header {
    max-width: 880px;
    margin-bottom: 72px;
  }
  @media (max-width: 920px) { .hero-header { margin-bottom: 56px; } }

  .hero-copy .eyebrow { margin-bottom: 28px; }
  .hero-copy h1 .em {
    font-style: italic;
    font-weight: 800;
    letter-spacing: -0.06em;
  }
  .hero-copy h1 .em::after {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--tick);
    margin-left: 0.08em;
    vertical-align: 0.6em;
  }
  .hero-sub {
    margin-top: 28px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 520px;
  }
  .hero-ctas {
    margin-top: 36px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .hero-beta-hint {
    margin-top: 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .hero-beta-hint .badge {
    padding: 3px 8px;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink);
    font-size: 10px;
    background: var(--paper-2);
  }
  .hero-beta-hint .badge .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tick);
    display: inline-block;
    margin-right: 6px;
    vertical-align: 1px;
  }

  /* ── Extract diagram ── */
  .extract {
    position: relative;
    margin-bottom: 0;
  }
  .extract-input {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 0;
  }
  .extract-step {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .extract-step .num {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .extract-bubble {
    background: var(--ink);
    color: var(--paper);
    padding: 16px 22px;
    border-radius: 22px;
    border-bottom-right-radius: 6px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 520px;
    line-height: 1.4;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .extract-bubble .time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(250,250,247,0.5);
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }
  .extract-fan {
    position: relative;
    height: 88px;
    margin: 4px 0;
  }
  .extract-fan svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--hair-2);
    pointer-events: none;
  }
  .extract-fan-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--paper);
    padding: 6px 14px;
    border: 1px solid var(--hair);
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    z-index: 1;
    white-space: nowrap;
  }
  .extract-fan-label .num {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .extract-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  @media (max-width: 920px) { .extract-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .extract-grid { grid-template-columns: 1fr; } }

  .ex-card {
    background: var(--paper-2);
    border: 1px solid var(--hair);
    border-radius: var(--r-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    min-height: 188px;
    position: relative;
    transition: border-color .2s ease, transform .2s ease;
  }
  .ex-card:hover { border-color: var(--hair-2); transform: translateY(-2px); }
  .ex-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .ex-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .ex-glyph {
    width: 26px;
    height: 26px;
    border: 1px solid var(--hair-2);
    border-radius: 7px;
    display: grid;
    place-items: center;
    font-size: 12px;
    color: var(--ink);
    font-weight: 600;
  }
  .ex-value {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 6px;
  }
  .ex-value-unit {
    font-size: 14px;
    color: var(--muted);
    margin-left: 4px;
    letter-spacing: 0;
    font-weight: 500;
  }
  .ex-sub {
    font-size: 12px;
    color: var(--muted);
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
  }
  .ex-bar {
    margin-top: auto;
    height: 5px;
    background: var(--paper-3);
    border-radius: 999px;
    overflow: hidden;
  }
  .ex-bar-fill {
    height: 100%;
    background: var(--ink);
    border-radius: 999px;
  }
  .ex-bar-label {
    margin-top: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.02em;
    display: flex;
    justify-content: space-between;
  }
  .ex-macros {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 2px;
  }
  .ex-macro-row {
    display: grid;
    grid-template-columns: 16px 1fr 38px;
    align-items: center;
    gap: 10px;
  }
  .ex-macro-k {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    font-weight: 600;
  }
  .ex-macro-bar {
    height: 4px;
    background: var(--paper-3);
    border-radius: 999px;
    overflow: hidden;
  }
  .ex-macro-fill {
    height: 100%;
    background: var(--ink);
    border-radius: 999px;
  }
  .ex-macro-v {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }
  .ex-card.ex-reply {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .ex-card.ex-reply:hover { border-color: var(--ink); }
  .ex-reply .ex-label { color: rgba(250,250,247,0.45); }
  .ex-reply .ex-glyph {
    border-color: rgba(22,163,74,0.4);
    color: var(--tick);
    background: rgba(22,163,74,0.18);
  }
  .ex-reply-bubble {
    font-size: 14px;
    line-height: 1.5;
    color: var(--paper);
    letter-spacing: -0.005em;
  }
  .ex-reply-bubble .tick {
    color: var(--tick);
    font-weight: 800;
    margin-right: 4px;
  }
  .ex-reply-tag {
    margin-top: auto;
    padding-top: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(250,250,247,0.45);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ex-reply-tag .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tick);
    box-shadow: 0 0 8px rgba(22,163,74,0.6);
  }

  /* ── Meta strip ── */
  .hero-meta {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--hair);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  @media (max-width: 720px) { .hero-meta { grid-template-columns: 1fr 1fr; gap: 18px; } }
  .hero-meta-item { display: flex; flex-direction: column; gap: 4px; }
  .hero-meta-item .k {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .hero-meta-item .v {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tick);
    box-shadow: 0 0 0 0 rgba(22,163,74,0.4);
    animation: pulseDot 1.8s ease-in-out infinite;
  }
</style>
