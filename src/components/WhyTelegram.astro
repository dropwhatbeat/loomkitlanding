---
---
<section class="py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <!-- Headline -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-[#F9FAFB]">
        The best app is the one you<br />
        <span class="text-[#7C3AED]">already have open.</span>
      </h2>
    </div>

    <!-- Two column layout -->
    <div class="flex flex-col md:flex-row items-start gap-12 md:gap-16">

      <!-- Left: bullet points -->
      <div class="flex-1 flex flex-col gap-6">
        <div class="flex items-start gap-4">
          <div class="w-6 h-6 rounded-full bg-[#7C3AED]/15 border border-[#7C3AED]/30 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <p class="text-[#F9FAFB] text-lg leading-relaxed">No download. No onboarding. No new passwords.</p>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-6 h-6 rounded-full bg-[#7C3AED]/15 border border-[#7C3AED]/30 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <p class="text-[#F9FAFB] text-lg leading-relaxed">Telegram is already open on your phone. LoomKit lives there.</p>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-6 h-6 rounded-full bg-[#7C3AED]/15 border border-[#7C3AED]/30 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <p class="text-[#F9FAFB] text-lg leading-relaxed">One message. Done. Back to your life.</p>
        </div>
      </div>

      <!-- Right: comparison visual -->
      <div class="flex-1 flex flex-col sm:flex-row gap-4">

        <!-- Other apps box -->
        <div class="flex-1 border border-red-900/40 bg-red-950/10 rounded-2xl p-6">
          <p class="text-[#6B7280] text-xs font-semibold uppercase tracking-widest mb-4">Other apps</p>
          <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-red-900/40 flex items-center justify-center text-red-400 text-xs font-bold flex-shrink-0">1</span>
              <span class="text-[#6B7280] text-sm line-through decoration-red-800">Download</span>
            </div>
            <div class="w-0 h-4 border-l border-dashed border-red-900/40 ml-2.5"></div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-red-900/40 flex items-center justify-center text-red-400 text-xs font-bold flex-shrink-0">2</span>
              <span class="text-[#6B7280] text-sm line-through decoration-red-800">Sign up</span>
            </div>
            <div class="w-0 h-4 border-l border-dashed border-red-900/40 ml-2.5"></div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-red-900/40 flex items-center justify-center text-red-400 text-xs font-bold flex-shrink-0">3</span>
              <span class="text-[#6B7280] text-sm line-through decoration-red-800">Learn UI</span>
            </div>
          </div>
        </div>

        <!-- LoomKit box -->
        <div class="flex-1 border border-[#10B981]/40 bg-[#10B981]/5 rounded-2xl p-6 flex flex-col justify-center items-center text-center">
          <p class="text-[#10B981] text-xs font-semibold uppercase tracking-widest mb-4">LoomKit</p>
          <p class="text-[#F9FAFB] text-2xl font-bold">Type.</p>
          <p class="text-[#10B981] text-2xl font-bold">Done.</p>
          <div class="mt-4 text-3xl">✅</div>
        </div>

      </div>
    </div>
  </div>
</section>
