---
import copy from '../copy.json';
const c = copy.whyTelegram;
---
<section class="section alt" id="about">
  <div class="wrap">
    <div class="why-grid">
      <div class="why-copy reveal">
        <span class="eyebrow"><span class="num">04</span> <span class="bar"></span> {c.eyebrow}</span>
        <h2>{c.headline}</h2>
        <ul class="why-list">
          {c.points.map(point => (
            <li><span class="why-check">✓</span> {point}</li>
          ))}
        </ul>
      </div>

      <div class="contrast reveal stagger">
        <div class="contrast-card them">
          <div class="contrast-label"><span>{c.themLabel}</span></div>
          <div class="contrast-flow">
            {c.themSteps.map((step, i) => (
              <>
                <span class={`contrast-step${i === c.themSteps.length - 1 ? ' dead' : ''}`}>{step}</span>
                {i < c.themSteps.length - 1 && <span class="contrast-arrow">→</span>}
              </>
            ))}
          </div>
          <div class="contrast-time-them">~ <span class="em-dark">{c.themTime.replace('~ ', '')}</span></div>
        </div>

        <div class="contrast-card us">
          <div class="contrast-label us-label"><span>{c.usLabel}</span></div>
          <div class="contrast-bubble">
            <span class="done">✓</span>
            {c.usMessage}
          </div>
          <div class="contrast-time">~ <span class="em">{c.usTime.replace('~ ', '')}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 920px) { .why-grid { grid-template-columns: 1fr; gap: 48px; } }

  .why-copy .eyebrow { margin-bottom: 24px; }
  .why-copy h2 { margin-bottom: 24px; }
  .why-list {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--hair);
  }
  .why-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-size: 18px;
    color: var(--ink);
    font-weight: 500;
    line-height: 1.4;
    padding: 18px 0;
    border-bottom: 1px solid var(--hair);
    letter-spacing: -0.01em;
  }
  .why-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--tick-soft);
    color: var(--tick);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font-weight: 800;
    margin-top: 2px;
    font-size: 11px;
  }

  .contrast {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contrast-card {
    border: 1px solid var(--hair);
    border-radius: var(--r-lg);
    padding: 24px;
    background: var(--paper);
  }
  .contrast-card.us {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .contrast-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .us-label { color: rgba(250,250,247,0.5); }
  .contrast-flow {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .contrast-step {
    padding: 7px 11px;
    border-radius: 8px;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    font-size: 12.5px;
    color: var(--muted);
    font-weight: 500;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: -0.01em;
  }
  .contrast-step.dead {
    text-decoration: line-through;
    text-decoration-color: var(--muted-2);
    color: var(--muted-2);
  }
  .contrast-arrow { color: var(--muted-2); font-size: 12px; }
  .contrast-bubble {
    background: var(--paper);
    color: var(--ink);
    padding: 12px 16px;
    border-radius: 16px;
    border-bottom-left-radius: 5px;
    font-size: 15px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: fit-content;
  }
  .done {
    width: 18px;
    height: 18px;
    background: var(--tick);
    color: white;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 10px;
    font-weight: 800;
  }
  .contrast-time {
    margin-top: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: rgba(250,250,247,0.5);
    letter-spacing: 0.1em;
  }
  .contrast-time .em { color: var(--paper); }
  .contrast-time-them {
    margin-top: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--muted-2);
    letter-spacing: 0.06em;
  }
  .contrast-time-them .em-dark { color: var(--ink); }
</style>
