---
import copy from '../copy.json';
const c = copy.footer;
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="#top">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 5h16M4 12h16M4 19h16"/>
              <path d="M9 5v14M15 5v14" opacity="0.4"/>
            </svg>
            <span class="dot"></span>
          </span>
          LoomKit
        </a>
        <p class="foot-tag">{c.tagline1}<br/>{c.tagline2}</p>
      </div>
      <div class="foot-links">
        <a href="https://t.me/Loomkit_bot" target="_blank" rel="noopener" data-whitelist>@Loomkit_bot ↗</a>
        <a href="#features">Features</a>
        <a href="#feedback">Contact</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{c.copyright}</span>
      <span>{c.version}</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--hair);
    padding: 56px 0 36px;
    background: var(--paper);
  }
  .foot-grid {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .foot-brand { max-width: 360px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .brand-mark {
    width: 22px;
    height: 22px;
    position: relative;
    display: grid;
    place-items: center;
  }
  .brand-mark svg { width: 100%; height: 100%; }
  .brand-mark .dot {
    position: absolute;
    right: -2px;
    bottom: -1px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tick);
    border: 1.5px solid var(--paper);
  }
  .foot-tag {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .foot-links {
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .foot-links a {
    font-size: 14px;
    color: var(--muted);
    transition: color .2s ease;
    cursor: pointer;
  }
  .foot-links a:hover { color: var(--ink); }
  .foot-bottom {
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--muted-2);
    letter-spacing: 0.06em;
  }
</style>
