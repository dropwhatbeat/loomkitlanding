---
---
<footer class="border-t border-gray-800 bg-[#0D0D0D]">
  <div class="max-w-7xl mx-auto px-6 py-10">
    <!-- Main row -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-8">
      <!-- Wordmark -->
      <a href="/" class="text-xl font-bold text-[#7C3AED] tracking-tight">LoomKit</a>

      <!-- Center text -->
      <p class="text-[#6B7280] text-sm text-center">
        Built with love and too much caffeine.
      </p>

      <!-- CTA -->
      <a
        href="https://t.me/Loomkit_bot"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[#7C3AED] hover:text-[#6D28D9] text-sm font-semibold transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.17 13.585l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.978.974z"/>
        </svg>
        Open @Loomkit_bot
      </a>
    </div>

    <!-- Bottom copyright -->
    <div class="border-t border-gray-800/60 pt-6 text-center">
      <p class="text-[#6B7280] text-xs">© 2025 LoomKit. All rights reserved.</p>
    </div>
  </div>
</footer>
