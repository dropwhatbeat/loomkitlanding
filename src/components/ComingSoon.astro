---
---
<section class="py-24 px-6 bg-[#0D0D0D]">
  <div class="max-w-7xl mx-auto">
    <!-- Headline -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-[#F9FAFB] mb-4">
        What's coming to <span class="text-[#7C3AED]">the kit.</span>
      </h2>
      <p class="text-[#6B7280]">We're just getting started.</p>
    </div>

    <!-- 2x2 grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto">

      <!-- Card 1: Food photo -->
      <div class="coming-card relative border border-[#7C3AED]/20 rounded-2xl p-6 bg-[#1A1A2E] opacity-80 hover:opacity-100 transition-all duration-300 group">
        <span class="absolute top-4 right-4 text-[10px] font-semibold text-[#6B7280] bg-[#0D0D0D] border border-gray-700/60 px-2 py-0.5 rounded-full uppercase tracking-wider">Coming Soon</span>
        <div class="text-3xl mb-4">📸</div>
        <h3 class="text-[#F9FAFB] font-bold text-lg mb-2">Food photo recognition</h3>
        <p class="text-[#6B7280] text-sm leading-relaxed">Snap your plate. Get your macros.</p>
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="box-shadow: 0 0 0 1px rgba(124,58,237,0.4), 0 0 20px rgba(124,58,237,0.1);"></div>
      </div>

      <!-- Card 2: Voice logging -->
      <div class="coming-card relative border border-[#7C3AED]/20 rounded-2xl p-6 bg-[#1A1A2E] opacity-80 hover:opacity-100 transition-all duration-300 group">
        <span class="absolute top-4 right-4 text-[10px] font-semibold text-[#6B7280] bg-[#0D0D0D] border border-gray-700/60 px-2 py-0.5 rounded-full uppercase tracking-wider">Coming Soon</span>
        <div class="text-3xl mb-4">🎙️</div>
        <h3 class="text-[#F9FAFB] font-bold text-lg mb-2">Voice logging</h3>
        <p class="text-[#6B7280] text-sm leading-relaxed">Talk faster than you type. We're listening.</p>
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="box-shadow: 0 0 0 1px rgba(124,58,237,0.4), 0 0 20px rgba(124,58,237,0.1);"></div>
      </div>

      <!-- Card 3: Bank sync -->
      <div class="coming-card relative border border-[#7C3AED]/20 rounded-2xl p-6 bg-[#1A1A2E] opacity-80 hover:opacity-100 transition-all duration-300 group">
        <span class="absolute top-4 right-4 text-[10px] font-semibold text-[#6B7280] bg-[#0D0D0D] border border-gray-700/60 px-2 py-0.5 rounded-full uppercase tracking-wider">Coming Soon</span>
        <div class="text-3xl mb-4">🏦</div>
        <h3 class="text-[#F9FAFB] font-bold text-lg mb-2">Bank sync</h3>
        <p class="text-[#6B7280] text-sm leading-relaxed">Your card already knows. We'll ask it.</p>
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="box-shadow: 0 0 0 1px rgba(124,58,237,0.4), 0 0 20px rgba(124,58,237,0.1);"></div>
      </div>

      <!-- Card 4: Dashboard -->
      <div class="coming-card relative border border-[#7C3AED]/20 rounded-2xl p-6 bg-[#1A1A2E] opacity-80 hover:opacity-100 transition-all duration-300 group">
        <span class="absolute top-4 right-4 text-[10px] font-semibold text-[#6B7280] bg-[#0D0D0D] border border-gray-700/60 px-2 py-0.5 rounded-full uppercase tracking-wider">Coming Soon</span>
        <div class="text-3xl mb-4">📊</div>
        <h3 class="text-[#F9FAFB] font-bold text-lg mb-2">Dashboard</h3>
        <p class="text-[#6B7280] text-sm leading-relaxed">Your data, visualised. Web app coming soon.</p>
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="box-shadow: 0 0 0 1px rgba(124,58,237,0.4), 0 0 20px rgba(124,58,237,0.1);"></div>
      </div>

    </div>
  </div>
</section>
