---
---
<section id="features" class="py-24 px-6 bg-[#0D0D0D]">
  <div class="max-w-7xl mx-auto">
    <!-- Headline -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-[#F9FAFB] mb-4">
        Everything you track.<br />
        <span class="text-[#7C3AED]">One place you already live.</span>
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Card 1: Expense Logging -->
      <div class="feature-card bg-[#1A1A2E] rounded-2xl p-8 border border-gray-800/40 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#7C3AED]/10 transition-all duration-300 opacity-0 translate-y-8">
        <div class="text-4xl mb-5">💸</div>
        <h3 class="text-[#F9FAFB] font-bold text-xl mb-3">Expense Logging</h3>
        <p class="text-[#6B7280] leading-relaxed">
          Just say what you spent. It categorises, converts currency, and logs it instantly.
        </p>
      </div>

      <!-- Card 2: Calorie Tracking -->
      <div class="feature-card bg-[#1A1A2E] rounded-2xl p-8 border border-gray-800/40 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#10B981]/10 transition-all duration-300 opacity-0 translate-y-8">
        <div class="text-4xl mb-5">🥗</div>
        <h3 class="text-[#F9FAFB] font-bold text-xl mb-3">Calorie Tracking</h3>
        <p class="text-[#6B7280] leading-relaxed">
          Text a meal or snap a photo. No manual entry, no counting, no guilt.
        </p>
      </div>

      <!-- Card 3: Smart Reminders -->
      <div class="feature-card bg-[#1A1A2E] rounded-2xl p-8 border border-gray-800/40 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#7C3AED]/10 transition-all duration-300 opacity-0 translate-y-8">
        <div class="text-4xl mb-5">⏰</div>
        <h3 class="text-[#F9FAFB] font-bold text-xl mb-3">Smart Reminders</h3>
        <p class="text-[#6B7280] leading-relaxed">
          "In 2 hours", "tomorrow morning" — it speaks human.
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.feature-card');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          (entry.target as HTMLElement).style.opacity = '1';
          (entry.target as HTMLElement).style.transform = 'translateY(0)';
          (entry.target as HTMLElement).style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        }, i * 150);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  cards.forEach(card => observer.observe(card));
</script>
