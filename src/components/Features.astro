---
import copy from '../copy.json';
const c = copy.features;
---
<section class="section alt" id="features">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow"><span class="bar"></span> {c.eyebrow}</span>
      </div>
      <div>
        <h2>{c.headline}</h2>
        <p class="lede">{c.lede}</p>
      </div>
    </div>

    <div class="feat-grid stagger reveal">
      {c.items.map(item => (
        <div class="feat-card">
          <div class="feat-num">
            <span class="glyph">{item.glyph}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <div class="feat-example">
            <div class="you">{item.userMsg}</div>
            <div class="bot">{item.botMsg}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
  }
  @media (max-width: 920px) { .feat-grid { grid-template-columns: 1fr; } }

  .feat-card {
    position: relative;
    padding: 36px 28px;
    border-right: 1px solid var(--hair);
    transition: background .2s ease;
  }
  .feat-card:last-child { border-right: none; }
  @media (max-width: 920px) {
    .feat-card { border-right: none; border-bottom: 1px solid var(--hair); }
    .feat-card:last-child { border-bottom: none; }
  }
  .feat-card:hover { background: var(--paper); }

  .feat-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--muted-2);
    letter-spacing: 0.16em;
    margin-bottom: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .feat-num .glyph {
    width: 28px;
    height: 28px;
    border: 1px solid var(--hair-2);
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: var(--ink);
    font-size: 14px;
  }
  .feat-card h3 { margin-bottom: 10px; }
  .feat-card p { font-size: 15px; line-height: 1.55; }
  .feat-card .feat-example {
    margin-top: 22px;
    padding: 12px 14px;
    background: var(--paper-3);
    border-radius: 10px;
    border: 1px solid var(--hair);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
  }
  .feat-example .you::before { content: '→ '; color: var(--ink); }
  .feat-example .you { color: var(--ink); }
  .feat-example .bot::before { content: '✓ '; color: var(--tick); }
  .feat-example .bot { color: var(--muted); }
</style>
